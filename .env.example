# CapabilityGuard - ArmorClaw + ArmorIQ Configuration

# ════════════════════════════════════════════════════════════
# JWT & TOKENS
# ════════════════════════════════════════════════════════════
JWT_SECRET=your-secret-key-min-32-characters-long

# ════════════════════════════════════════════════════════════
# OPA POLICY ENGINE
# ════════════════════════════════════════════════════════════
OPA_URL=http://localhost:8181/v1/data/financial

# ════════════════════════════════════════════════════════════
# ALPACA PAPER TRADING API
# ════════════════════════════════════════════════════════════
ALPACA_API_KEY=your-alpaca-paper-api-key
ALPACA_SECRET_KEY=your-alpaca-paper-secret-key
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ════════════════════════════════════════════════════════════
# AUDIT LOG DATABASE
# ════════════════════════════════════════════════════════════
AUDIT_DB_PATH=./audit.db

# ════════════════════════════════════════════════════════════
# ARMORIQ INTENT ASSURANCE
# ════════════════════════════════════════════════════════════
# Your ArmorIQ API credentials from https://armoriq.ai
ARMORIQ_API_KEY=your-armoriq-api-key
ARMORIQ_API_URL=https://api.armoriq.ai
ARMORIQ_WEBHOOK_SECRET=optional-webhook-secret

# ════════════════════════════════════════════════════════════
# ORCHESTRATOR & SERVICES
# ════════════════════════════════════════════════════════════
ORCHESTRATOR_HOST=localhost
ORCHESTRATOR_PORT=8000
GATEWAY_HOST=localhost
GATEWAY_PORT=8001
